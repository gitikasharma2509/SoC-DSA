#include <iostream>
#include <string>
using namespace std;

int main() {
    int n;
    cin >> n;

    string s;
    cin >> s;

    int i = 0;

    while (n > 0) {

        if (n == 2) {
            for (int j = i; j < i + 2; j++)
                cout << s[j];
            break;
        }

        else if (n == 3) {
            for (int j = i; j < i + 3; j++)
                cout << s[j];
            break;
        }

        else if (n == 4) {
            for (int j = i; j < i + 2; j++)
                cout << s[j];
            cout << "-";
            for (int j = i + 2; j < i + 4; j++)
                cout << s[j];
            break;
        }

        else {
            for (int j = i; j < i + 2; j++)
                cout << s[j];
            cout << "-";
            i += 2;
            n -= 2;
        }
    }

    return 0;
}