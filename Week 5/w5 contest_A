#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int k;
        cin >> k;

        int twice = 0;
        bool ok = false;

        for (int i = 0; i < k; i++) {
            long long x;
            cin >> x;

            if (x >= 3)
                ok = true;
            else if (x == 2)
                twice++;
        }

        if (ok || twice >= 2)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}