#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main() {
    vector<string> a;
    string s;
    int maxlen = 0;

    while (cin >> s) {
        a.push_back(s);
        if (s.length() > maxlen)
            maxlen = s.length();
    }

    for (int i = 0; i < maxlen + 2; i++)
        cout << "*";
    cout << endl;

    bool turn = 0;

    for (int i = 0; i < a.size(); i++) {

        int extra = maxlen - a[i].length();
        int left = extra / 2;
        int right = extra / 2;

        if (extra % 2 == 1) {
            if (turn == 0)
                right++;
            else
                left++;
            turn = !turn;
        }

        cout << "*";

        for (int j = 0; j < left; j++)
            cout << " ";

        cout << a[i];

        for (int j = 0; j < right; j++)
            cout << " ";

        cout << "*" << endl;
    }

    for (int i = 0; i < maxlen + 2; i++)
        cout << "*";

    return 0;
}