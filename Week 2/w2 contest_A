#include <iostream>
#include <string>
using namespace std;

int main(){
    string s;
    int count =0;
    long long ans=0;

    while (cin >> s) {
        if (s[0] == '+'){
            count++;
        }
        else if (s[0] == '-') {
            count--;
        }
        else {
            int pos =0;
            while (s[pos] != ':')
            pos++;

            int len =s.length() - pos -1;
            ans += count*len;
        }
    }
}